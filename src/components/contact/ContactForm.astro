---
import Button from '../shared/Button.astro';
import { services } from '../../data/services';
---

<form action="https://formspree.io/f/FORMSPREE_FORM_ID" method="POST" class="space-y-6">
  <!-- Name -->
  <div>
    <label for="name" class="block text-sm font-medium text-neutral-700 mb-1">Your Name</label>
    <input
      type="text"
      id="name"
      name="name"
      required
      placeholder="John Doe"
      class="w-full min-h-[44px] px-4 py-3 border border-neutral-300 rounded-xl text-neutral-900 placeholder:text-neutral-400 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors"
    />
  </div>

  <!-- Email -->
  <div>
    <label for="email" class="block text-sm font-medium text-neutral-700 mb-1">Work Email</label>
    <input
      type="email"
      id="email"
      name="email"
      required
      placeholder="john@company.com"
      class="w-full min-h-[44px] px-4 py-3 border border-neutral-300 rounded-xl text-neutral-900 placeholder:text-neutral-400 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors"
    />
  </div>

  <!-- Company -->
  <div>
    <label for="company" class="block text-sm font-medium text-neutral-700 mb-1">Company Name</label>
    <input
      type="text"
      id="company"
      name="company"
      placeholder="Acme Inc."
      class="w-full min-h-[44px] px-4 py-3 border border-neutral-300 rounded-xl text-neutral-900 placeholder:text-neutral-400 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors"
    />
  </div>

  <!-- Phone -->
  <div>
    <label for="phone" class="block text-sm font-medium text-neutral-700 mb-1">Phone Number</label>
    <input
      type="tel"
      id="phone"
      name="phone"
      placeholder="+1 (555) 000-0000"
      class="w-full min-h-[44px] px-4 py-3 border border-neutral-300 rounded-xl text-neutral-900 placeholder:text-neutral-400 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors"
    />
  </div>

  <!-- Service Interest -->
  <div>
    <label for="service" class="block text-sm font-medium text-neutral-700 mb-1">What Can We Help With?</label>
    <select
      id="service"
      name="service"
      class="w-full min-h-[44px] px-4 py-3 border border-neutral-300 rounded-xl text-neutral-900 bg-white focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors"
    >
      <option value="">General enquiry</option>
      <option value="BizAgent">BizAgent (product)</option>
      {services.map((s) => (
        <option value={s.title}>{s.shortTitle}</option>
      ))}
    </select>
  </div>

  <!-- Message -->
  <div>
    <label for="message" class="block text-sm font-medium text-neutral-700 mb-1">Tell Us About Your Project</label>
    <textarea
      id="message"
      name="message"
      required
      rows="5"
      placeholder="Describe your project, timeline, and goals..."
      class="w-full px-4 py-3 border border-neutral-300 rounded-xl text-neutral-900 placeholder:text-neutral-400 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors resize-y"
    ></textarea>
  </div>

  <p class="text-sm text-neutral-500">
    We use your details only to reply to your enquiry. See our <a href="/privacy" class="text-primary-700 underline underline-offset-2">privacy policy</a>.
  </p>

  <Button variant="primary" size="lg" class="w-full sm:w-auto">
    Send message
  </Button>
</form>
