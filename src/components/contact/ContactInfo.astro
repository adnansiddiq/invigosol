---
import { company } from '../../data/company';
import { Mail, Phone, MapPin, ExternalLink } from '@lucide/astro';
---

<div class="bg-neutral-50 rounded-xl p-6 lg:p-8 border border-neutral-200">
  <h2 class="text-xl font-semibold text-neutral-900 mb-6">Get in Touch</h2>

  <div class="space-y-4">
    <a href={`mailto:${company.email}`} class="flex items-start gap-3 text-neutral-700 hover:text-primary-600 transition-colors py-1">
      <Mail class="h-5 w-5 text-primary-600 mt-0.5 shrink-0" />
      <span>{company.email}</span>
    </a>
    <div class="flex items-start gap-3 text-neutral-700 py-1">
      <Phone class="h-5 w-5 text-primary-600 mt-0.5 shrink-0" />
      <span>{company.phone}</span>
    </div>
    <div class="flex items-start gap-3 text-neutral-700 py-1">
      <MapPin class="h-5 w-5 text-primary-600 mt-0.5 shrink-0" />
      <span>{company.location}</span>
    </div>
  </div>

  <div class="mt-8 pt-6 border-t border-neutral-200">
    <h3 class="text-sm font-semibold text-neutral-900 uppercase tracking-wider mb-4">Follow Us</h3>
    <div class="space-y-3">
      <a href={company.social.linkedin} class="flex items-center gap-2 text-sm text-neutral-600 hover:text-primary-600 transition-colors py-1" target="_blank" rel="noopener noreferrer">
        <ExternalLink class="h-4 w-4" /> LinkedIn
      </a>
      <a href={company.social.github} class="flex items-center gap-2 text-sm text-neutral-600 hover:text-primary-600 transition-colors py-1" target="_blank" rel="noopener noreferrer">
        <ExternalLink class="h-4 w-4" /> GitHub
      </a>
      <a href={company.social.twitter} class="flex items-center gap-2 text-sm text-neutral-600 hover:text-primary-600 transition-colors py-1" target="_blank" rel="noopener noreferrer">
        <ExternalLink class="h-4 w-4" /> Twitter/X
      </a>
    </div>
  </div>
</div>
