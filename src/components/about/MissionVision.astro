---
import Container from '../shared/Container.astro';
import { Target, Telescope } from '@lucide/astro';
---

<section class="py-16 sm:py-20">
  <Container>
    <div class="grid gap-8 md:grid-cols-2">
      <div class="bg-primary-50 rounded-xl p-8 border border-primary-100">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-primary-100 text-primary-700 mb-4">
          <Target class="h-6 w-6" />
        </div>
        <h2 class="text-2xl font-bold text-neutral-900 mb-4">Our Mission</h2>
        <p class="text-neutral-700 leading-relaxed">
          To empower businesses with intelligent, production-grade technology solutions that drive
          real-world impact — delivered with transparency, speed, and engineering excellence.
        </p>
      </div>
      <div class="bg-neutral-50 rounded-xl p-8 border border-neutral-200">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-lg bg-neutral-200 text-neutral-700 mb-4">
          <Telescope class="h-6 w-6" />
        </div>
        <h2 class="text-2xl font-bold text-neutral-900 mb-4">Our Vision</h2>
        <p class="text-neutral-700 leading-relaxed">
          To be the technology partner that forward-thinking companies trust to build their most
          critical, AI-native systems.
        </p>
      </div>
    </div>
  </Container>
</section>
