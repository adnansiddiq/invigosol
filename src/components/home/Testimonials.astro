---
import Container from '../shared/Container.astro';
import SectionHeading from '../shared/SectionHeading.astro';
import { Quote } from '@lucide/astro';

const testimonials = [
  {
    quote:
      "Invigosol didn't just deliver a product — they helped us rethink how we build software. Their AI-native approach shaved months off our roadmap.",
    name: 'VP of Engineering',
    company: 'Enterprise SaaS Company',
  },
  {
    quote:
      'The DevOps transformation was seamless. Our deployment frequency went from bi-weekly to multiple times a day with zero downtime.',
    name: 'CTO',
    company: 'FinTech Startup',
  },
  {
    quote:
      'Their architecture team designed a system that handled our 10x growth without a single re-architecture. That kind of foresight is rare.',
    name: 'Head of Platform',
    company: 'E-Commerce Company',
  },
];
---

<section class="py-16 sm:py-20">
  <Container>
    <SectionHeading title="What Our Clients Say" />
    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {testimonials.map((t) => (
        <div class="bg-white rounded-xl border border-neutral-200 p-6">
          <Quote class="h-8 w-8 text-primary-200 mb-4" />
          <blockquote class="text-neutral-700 leading-relaxed mb-4">
            "{t.quote}"
          </blockquote>
          <div class="border-t border-neutral-100 pt-4">
            <p class="font-semibold text-neutral-900 text-sm">{t.name}</p>
            <p class="text-neutral-500 text-sm">{t.company}</p>
          </div>
        </div>
      ))}
    </div>
  </Container>
</section>
