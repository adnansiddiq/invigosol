---
import Container from '../shared/Container.astro';
import SectionHeading from '../shared/SectionHeading.astro';
import { Cpu, Gauge, ShieldCheck, Handshake } from '@lucide/astro';

const pillars = [
  {
    icon: Cpu,
    title: 'AI-native, not AI-washed',
    description:
      'We build and run our own AI product, BizAgent, so our advice comes from operating AI in production, not from slide decks.',
  },
  {
    icon: Gauge,
    title: 'Measured from day one',
    description:
      'Every AI project starts with an evaluation set and a business metric. You see quality, cost and time saved, not just a demo.',
  },
  {
    icon: ShieldCheck,
    title: 'Safe by design',
    description:
      'Human approval for sensitive actions, least-privilege access, audit logs and data-protection controls are part of the build.',
  },
  {
    icon: Handshake,
    title: 'No lock-in',
    description:
      'Your code, your cloud account, your data. We document decisions and hand over cleanly whenever you want.',
  },
];

const steps = [
  { title: 'Discovery call', description: 'A free 30-minute call to understand the goal and constraints.' },
  { title: 'Scoped proposal', description: 'A fixed-scope first phase with clear success metrics.' },
  { title: 'Pilot', description: 'Working software on your data within weeks, measured against the metric.' },
  { title: 'Scale & support', description: 'Production rollout, monitoring and ongoing improvement.' },
];
---

<section class="py-20 sm:py-24">
  <Container>
    <SectionHeading eyebrow="Why InvigoSol" title="Outcomes you can measure" />
    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {pillars.map(({ icon: IconComponent, title, description }) => (
        <div class="rounded-2xl border border-neutral-200 p-7">
          <div class="mb-5 inline-flex h-11 w-11 items-center justify-center rounded-xl brand-gradient text-white">
            <IconComponent class="h-5 w-5" />
          </div>
          <h3 class="text-lg font-bold text-neutral-950 mb-2">{title}</h3>
          <p class="text-sm text-neutral-600 leading-relaxed">{description}</p>
        </div>
      ))}
    </div>

    <div class="mt-20 rounded-3xl bg-neutral-50 border border-neutral-200 p-8 sm:p-12">
      <SectionHeading eyebrow="How we work" title="From first call to production" align="left" />
      <ol class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {steps.map((s, i) => (
          <li>
            <span class="font-[family-name:var(--font-brand)] text-4xl font-extrabold italic text-primary-500">0{i + 1}</span>
            <h3 class="mt-2 text-base font-bold text-neutral-950">{s.title}</h3>
            <p class="mt-1 text-sm text-neutral-600 leading-relaxed">{s.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </Container>
</section>
