---
import Container from '../shared/Container.astro';
import Button from '../shared/Button.astro';
import { Bot, Workflow, Wrench, Shield, Puzzle } from '@lucide/astro';

const capabilities = [
  { icon: Workflow, text: 'Multi-agent orchestration with built-in coordination' },
  { icon: Wrench, text: 'Tool-use and function-calling framework' },
  { icon: Shield, text: 'Production-grade observability and guardrails' },
  { icon: Puzzle, text: 'Extensible plugin architecture' },
];
---

<section class="py-16 sm:py-20 bg-neutral-900 text-white">
  <Container>
    <div class="grid gap-10 lg:grid-cols-2 items-center">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary-600/20 text-primary-300 text-sm font-medium mb-6">
          <Bot class="h-4 w-4" /> Platform
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold">Meet OpenClaw</h2>
        <p class="mt-2 text-lg text-neutral-400">Our AI Agent Development Platform</p>
        <p class="mt-4 text-neutral-300 leading-relaxed">
          OpenClaw is our open framework for building, orchestrating, and deploying autonomous AI
          agents. Whether you need agents that handle customer workflows, automate internal
          operations, or coordinate across systems — OpenClaw provides the architecture to go from
          concept to production-ready agent in weeks, not months.
        </p>
        <ul class="mt-6 space-y-3">
          {capabilities.map(({ icon: CapIcon, text }) => (
            <li class="flex items-center gap-3 text-neutral-300">
              <CapIcon class="h-5 w-5 text-primary-400 shrink-0" />
              <span>{text}</span>
            </li>
          ))}
        </ul>
        <div class="mt-8">
          <Button href="/services/agent-development" variant="primary">
            Explore Agent Development
          </Button>
        </div>
      </div>
      <div class="flex items-center justify-center">
        <div class="w-full max-w-md aspect-square rounded-2xl bg-gradient-to-br from-primary-800/50 to-neutral-800 border border-neutral-700 flex items-center justify-center">
          <Bot class="h-24 w-24 text-primary-400/50" />
        </div>
      </div>
    </div>
  </Container>
</section>
