---
import Container from '../shared/Container.astro';
import Button from '../shared/Button.astro';
import { ArrowRight } from '@lucide/astro';

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = 'Have an AI idea or a process that eats your team’s time?',
  subtitle = 'Tell us about it. In a free 30-minute call we will tell you honestly what AI can do, what it costs and how fast you can see results.',
} = Astro.props;
---

<section class="py-20 sm:py-24">
  <Container>
    <div class="relative overflow-hidden rounded-3xl brand-gradient px-6 py-14 sm:px-14 sm:py-16 text-white">
      <div class="absolute -right-10 -bottom-16 h-72 w-72 opacity-20" aria-hidden="true">
        <img src="/images/brand/invigosol-icon-white.svg" alt="" width="256" height="288" loading="lazy" />
      </div>
      <div class="relative max-w-2xl">
        <h2 class="text-3xl sm:text-4xl font-extrabold">{title}</h2>
        <p class="mt-4 text-lg text-white/90">{subtitle}</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <Button href="/contact" variant="secondary" size="lg">
            Book a consultation <ArrowRight class="h-5 w-5" />
          </Button>
          <Button href="mailto:hello@invigosol.com" variant="outline-white" size="lg">hello@invigosol.com</Button>
        </div>
      </div>
    </div>
  </Container>
</section>
