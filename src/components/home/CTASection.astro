---
import Container from '../shared/Container.astro';
import Button from '../shared/Button.astro';
---

<section class="py-16 sm:py-20 bg-gradient-to-r from-primary-600 to-primary-800 text-white">
  <Container class="text-center">
    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold">
      Ready to Build Something Intelligent?
    </h2>
    <p class="mt-4 text-primary-100 max-w-xl mx-auto text-lg">
      Whether you're modernizing legacy systems, building AI-native products, or scaling your
      engineering operations — we're ready when you are.
    </p>
    <div class="mt-8">
      <Button href="/contact" variant="white" size="lg">
        Let's Talk
      </Button>
    </div>
  </Container>
</section>
