---
import Container from '../shared/Container.astro';
import Breadcrumbs from '../shared/Breadcrumbs.astro';

interface Props {
  title: string;
  tagline: string;
}

const { title, tagline } = Astro.props;
---

<section class="bg-gradient-to-br from-primary-900 to-primary-700 text-white py-16 sm:py-20">
  <Container>
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Services', href: '/services' },
        { label: title },
      ]}
    />
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold mt-4">{title}</h1>
    <p class="mt-4 text-lg sm:text-xl text-primary-100 max-w-2xl">{tagline}</p>
  </Container>
</section>
