---
import type { Service } from '../../data/services';

interface Props {
  features: Service['features'];
}

const { features } = Astro.props;
---

<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
  {features.map((feature, index) => (
    <div class="rounded-xl border border-neutral-200 bg-white p-6">
      <div class="mb-3 inline-flex items-center justify-center w-8 h-8 rounded-full bg-primary-100 text-primary-700 text-sm font-bold">
        {index + 1}
      </div>
      <h3 class="text-lg font-semibold text-neutral-900 mb-2">{feature.title}</h3>
      <p class="text-sm text-neutral-600 leading-relaxed">{feature.description}</p>
    </div>
  ))}
</div>
