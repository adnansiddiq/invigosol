---
import type { Service } from '../../data/services';

interface Props {
  features: Service['features'];
}

const { features } = Astro.props;
---

<div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
  {features.map((feature) => (
    <div class="rounded-2xl border border-neutral-200 bg-white p-7">
      <div class="mb-4 h-1 w-10 rounded-full brand-gradient"></div>
      <h3 class="text-lg font-bold text-neutral-950 mb-2">{feature.title}</h3>
      <p class="text-sm text-neutral-600 leading-relaxed">{feature.description}</p>
    </div>
  ))}
</div>
