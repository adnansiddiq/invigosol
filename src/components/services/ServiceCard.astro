---
import type { Service } from '../../data/services';
import Icon from '../shared/Icon.astro';
import { ArrowRight } from '@lucide/astro';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<a
  href={`/services/${service.slug}`}
  class="group relative flex flex-col rounded-2xl border border-neutral-200 bg-white p-7 transition-all hover:-translate-y-0.5 hover:border-primary-300 hover:shadow-xl hover:shadow-primary-900/5"
>
  <div class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary-50 text-primary-600 transition-colors group-hover:bg-primary-600 group-hover:text-white">
    <Icon name={service.icon} class="h-6 w-6" />
  </div>
  <h3 class="text-lg font-bold text-neutral-950 mb-2">{service.title}</h3>
  <p class="text-sm text-neutral-600 mb-6 leading-relaxed flex-1">{service.description}</p>
  <span class="inline-flex items-center gap-1 text-sm font-semibold text-primary-700 group-hover:gap-2 transition-all">
    Learn more <ArrowRight class="h-4 w-4" />
  </span>
</a>
