---
import type { Service } from '../../data/services';
import Icon from '../shared/Icon.astro';
import { ArrowRight } from '@lucide/astro';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<a
  href={`/services/${service.slug}`}
  class="group block rounded-xl border border-neutral-200 bg-white p-6 transition-all hover:shadow-lg hover:border-primary-200"
>
  <div class="mb-4 inline-flex items-center justify-center w-12 h-12 rounded-lg bg-primary-50 text-primary-600">
    <Icon name={service.icon} class="h-6 w-6" />
  </div>
  <h3 class="text-lg font-semibold text-neutral-900 mb-2">{service.title}</h3>
  <p class="text-sm text-neutral-600 mb-4 leading-relaxed">{service.description}</p>
  <span class="inline-flex items-center gap-1 text-sm font-medium text-primary-600 group-hover:gap-2 transition-all">
    Learn More <ArrowRight class="h-4 w-4" />
  </span>
</a>
