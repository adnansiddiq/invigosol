---
import Container from '../shared/Container.astro';
import Logo from '../shared/Logo.astro';
import { company } from '../../data/company';
import { footerLinks } from '../../data/navigation';
import { Mail, ArrowUpRight } from '@lucide/astro';

const columns = [
  { title: 'Services', links: footerLinks.services },
  { title: 'Products', links: footerLinks.products },
  { title: 'Company', links: footerLinks.company },
  { title: 'Legal', links: footerLinks.legal },
];

const social = [
  { label: 'LinkedIn', href: company.social.linkedin },
  { label: 'GitHub', href: company.social.github },
  { label: 'X (Twitter)', href: company.social.twitter },
];
---

<footer class="bg-ink-950 text-neutral-400">
  <div class="h-1 brand-gradient" aria-hidden="true"></div>
  <Container class="py-14 lg:py-16">
    <div class="grid grid-cols-2 gap-10 md:grid-cols-4 lg:grid-cols-6">
      <!-- Brand -->
      <div class="col-span-2">
        <a href="/" aria-label="InvigoSol home"><Logo tone="dark" /></a>
        <p class="mt-4 text-sm leading-relaxed max-w-xs">{company.description}</p>
        <a href={`mailto:${company.email}`} class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-white hover:text-primary-400 transition-colors">
          <Mail class="h-4 w-4" /> {company.email}
        </a>
        <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
          {social.map((s) => (
            <li>
              <a href={s.href} class="inline-flex items-center gap-1 text-sm hover:text-white transition-colors" target="_blank" rel="noopener noreferrer">
                {s.label} <ArrowUpRight class="h-3.5 w-3.5" />
              </a>
            </li>
          ))}
        </ul>
      </div>

      {columns.map((col) => (
        <div>
          <h3 class="text-xs font-semibold text-white uppercase tracking-widest mb-4">{col.title}</h3>
          <ul class="space-y-1">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="inline-block py-1.5 text-sm hover:text-white transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-white/10 flex flex-col md:flex-row md:items-center md:justify-between gap-3 text-xs text-neutral-500">
      <p>
        &copy; {new Date().getFullYear()} {company.legalName}. All rights reserved.
        {company.address && <span> {company.address}{company.country && `, ${company.country}`}.</span>}
      </p>
      <p>WhatsApp and Facebook are trademarks of Meta Platforms, Inc.</p>
    </div>
  </Container>
</footer>
