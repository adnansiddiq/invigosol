---
import {
  Bot,
  Sparkles,
  Workflow,
  MessageCircle,
  Rocket,
  GitBranch,
  Building2,
  ShieldCheck,
} from '@lucide/astro';

interface Props {
  name: string;
  class?: string;
}

const icons = { Bot, Sparkles, Workflow, MessageCircle, Rocket, GitBranch, Building2, ShieldCheck };

const { name, class: className } = Astro.props;
const Component = icons[name as keyof typeof icons] ?? Sparkles;
---

<Component class={className} />
