---
interface Props {
  title: string;
  subtitle?: string;
  align?: 'center' | 'left';
  class?: string;
}

const { title, subtitle, align = 'center', class: className } = Astro.props;
---

<div class:list={[align === 'center' ? 'text-center' : 'text-left', className]}>
  <h2 class="text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">
    {title}
  </h2>
  {subtitle && (
    <p class="mt-4 text-lg text-neutral-600 max-w-3xl" class:list={[align === 'center' && 'mx-auto']}>
      {subtitle}
    </p>
  )}
</div>
