---
// FAQ accordion that also emits FAQPage structured data.
import Container from './Container.astro';
import SectionHeading from './SectionHeading.astro';
import JsonLd from './JsonLd.astro';
import { Plus } from '@lucide/astro';

interface Props {
  faqs: { question: string; answer: string }[];
  title?: string;
  class?: string;
}

const { faqs, title = 'Frequently asked questions', class: className } = Astro.props;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<section class:list={['py-20 sm:py-24', className]}>
  <Container>
    <SectionHeading eyebrow="FAQ" title={title} />
    <div class="mx-auto mt-12 max-w-3xl divide-y divide-neutral-200 border-y border-neutral-200">
      {faqs.map((f) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-left text-base font-semibold text-neutral-950 [&::-webkit-details-marker]:hidden">
            {f.question}
            <Plus class="h-5 w-5 shrink-0 text-primary-600 transition-transform group-open:rotate-45" />
          </summary>
          <p class="mt-3 text-neutral-600 leading-relaxed">{f.answer}</p>
        </details>
      ))}
    </div>
  </Container>
</section>
<JsonLd data={faqJsonLd} />
