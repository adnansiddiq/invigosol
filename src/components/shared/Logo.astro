---
// Horizontal lockup (mark + wordmark), vector master from brand-kit/logos/svg.
interface Props {
  tone?: 'light' | 'dark';
  class?: string;
}

const { tone = 'light', class: className } = Astro.props;
const src = tone === 'light' ? '/images/brand/invigosol-logo-horizontal.svg' : '/images/brand/invigosol-logo-horizontal-white.svg';
---

<img src={src} alt="InvigoSol" width="155" height="48" class:list={['h-12 w-auto', className]} />
