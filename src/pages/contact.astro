---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/shared/Container.astro';
import Breadcrumbs from '../components/shared/Breadcrumbs.astro';
import ContactForm from '../components/contact/ContactForm.astro';
import ContactInfo from '../components/contact/ContactInfo.astro';
---

<BaseLayout
  title="Contact Us | Invigosol"
  description="Get in touch with Invigosol to discuss your technology project. We respond within one business day."
  canonicalPath="/contact"
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-primary-900 to-primary-700 text-white py-16 sm:py-20">
    <Container>
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Contact' }]} />
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold mt-4">
        Let's Build Something Intelligent
      </h1>
      <p class="mt-4 text-lg sm:text-xl text-primary-100 max-w-3xl">
        Whether you have a specific project in mind or want to explore how AI-native engineering can
        transform your business — we'd love to hear from you.
      </p>
    </Container>
  </section>

  <section class="py-16 sm:py-20">
    <Container>
      <div class="grid gap-10 lg:grid-cols-5">
        <div class="lg:col-span-3">
          <ContactForm />
        </div>
        <div class="lg:col-span-2">
          <ContactInfo />
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
