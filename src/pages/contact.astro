---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/shared/Container.astro';
import PageHero from '../components/shared/PageHero.astro';
import ContactForm from '../components/contact/ContactForm.astro';
import ContactInfo from '../components/contact/ContactInfo.astro';
---

<BaseLayout
  title="Contact InvigoSol | Book an AI Consultation"
  description="Talk to InvigoSol about AI agents, LLM apps, automation, WhatsApp Business API or cloud engineering. Free 30-minute consultation; we reply within one business day."
  canonicalPath="/contact"
>
  <PageHero
    eyebrow="Contact"
    title="Let's build something intelligent"
    subtitle="Tell us what you want to achieve. We will reply within one business day with honest advice and next steps."
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Contact' }]}
  />

  <section class="py-20 sm:py-24">
    <Container>
      <div class="grid gap-10 lg:grid-cols-5">
        <div class="lg:col-span-3">
          <ContactForm />
        </div>
        <div class="lg:col-span-2">
          <ContactInfo />
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
