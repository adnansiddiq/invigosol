---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/shared/Container.astro';
import PageHero from '../components/shared/PageHero.astro';
import MissionVision from '../components/about/MissionVision.astro';
import ValuesSection from '../components/about/ValuesSection.astro';
import ProductsSpotlight from '../components/home/ProductsSpotlight.astro';
import CTASection from '../components/home/CTASection.astro';
---

<BaseLayout
  title="About InvigoSol | AI-Native Technology Company"
  description="InvigoSol is an AI-native technology company that builds AI agents, LLM apps, WhatsApp integrations and cloud platforms, and makes the BizAgent product."
  canonicalPath="/about"
>
  <PageHero
    eyebrow="About us"
    title="We engineer intelligence and deliver outcomes"
    subtitle="InvigoSol is a technology company built for the AI era. We help businesses design, build and run intelligent systems that deliver measurable results, and we build our own products on the same stack."
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'About' }]}
  />

  <!-- Company Story -->
  <section class="py-20 sm:py-24">
    <Container>
      <div class="grid gap-12 lg:grid-cols-5">
        <div class="lg:col-span-2">
          <p class="text-sm font-semibold uppercase tracking-widest text-primary-600">Our story</p>
          <h2 class="mt-3 text-3xl sm:text-4xl font-bold text-neutral-950">Outcomes, not output</h2>
          <img src="/images/brand/logo-full.png" alt="InvigoSol, Tech & Solution" width="907" height="907" class="mt-8 hidden lg:block w-56 h-auto" loading="lazy" />
        </div>
        <div class="lg:col-span-3 space-y-5 text-lg text-neutral-700 leading-relaxed">
          <p>InvigoSol was founded on a simple belief: technology services should deliver outcomes, not just output.</p>
          <p>
            Every company is becoming a software company, and every software company is becoming an AI company. Yet many
            businesses are stuck with AI pilots that never reach production, and with teams that spend their days on
            work software should do for them.
          </p>
          <p>
            We are engineers, architects and product people working where AI, modern engineering and product strategy
            meet. We don't just advise; we build, and we own the result.
          </p>
          <p>
            We also build our own products. BizAgent, our WhatsApp and email monitoring app, runs on the same AI,
            WhatsApp Cloud API and cloud stack we deliver for clients, so we learn from operating it every day.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <MissionVision />
  <ValuesSection />
  <ProductsSpotlight />
  <CTASection />
</BaseLayout>
