---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/shared/Container.astro';
import Button from '../../components/shared/Button.astro';
import SectionHeading from '../../components/shared/SectionHeading.astro';
import PageHero from '../../components/shared/PageHero.astro';
import FaqSection from '../../components/shared/FaqSection.astro';
import ServiceFeatureList from '../../components/services/ServiceFeatureList.astro';
import RelatedServices from '../../components/services/RelatedServices.astro';
import CTASection from '../../components/home/CTASection.astro';
import { services, type Service } from '../../data/services';
import { company } from '../../data/company';
import { AlertCircle, ArrowRight } from '@lucide/astro';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  serviceType: service.title,
  description: service.meta.description,
  provider: { '@id': `${company.siteUrl}/#organization` },
  areaServed: 'Worldwide',
  url: `${company.siteUrl}/services/${service.slug}`,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: service.title,
    itemListElement: service.features.map((f) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: f.title, description: f.description },
    })),
  },
};
---

<BaseLayout
  title={service.meta.title}
  description={service.meta.description}
  canonicalPath={`/services/${service.slug}`}
  jsonLd={[serviceJsonLd]}
>
  <PageHero
    title={service.title}
    subtitle={service.tagline}
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'Services', href: '/services' },
      { label: service.shortTitle },
    ]}
  >
    <div class="mt-9 flex flex-col sm:flex-row gap-3">
      <Button href="/contact" size="lg">Talk to an expert <ArrowRight class="h-5 w-5" /></Button>
    </div>
  </PageHero>

  <!-- Overview and challenges -->
  <section class="py-20 sm:py-24">
    <Container>
      <div class="grid gap-12 lg:grid-cols-2">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-primary-600">Overview</p>
          <p class="mt-4 text-xl text-neutral-800 leading-relaxed">{service.longDescription}</p>
        </div>
        <div class="rounded-3xl bg-neutral-50 border border-neutral-200 p-8">
          <h2 class="text-xl font-bold text-neutral-950">Challenges we solve</h2>
          <ul class="mt-6 space-y-4">
            {service.challenges.map((challenge) => (
              <li class="flex items-start gap-3">
                <AlertCircle class="h-5 w-5 text-primary-600 mt-0.5 shrink-0" />
                <span class="text-neutral-700">{challenge}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </section>

  <!-- Features -->
  <section class="py-20 sm:py-24 bg-neutral-50">
    <Container>
      <SectionHeading eyebrow="What we deliver" title={`${service.shortTitle} capabilities`} />
      <div class="mt-12">
        <ServiceFeatureList features={service.features} />
      </div>
    </Container>
  </section>

  <!-- Process Steps -->
  <section class="py-20 sm:py-24">
    <Container>
      <SectionHeading eyebrow="Process" title="How we work" />
      <ol class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {service.processSteps.map((step) => (
          <li class="rounded-2xl border border-neutral-200 p-6">
            <span class="font-[family-name:var(--font-brand)] text-4xl font-extrabold italic text-primary-500">0{step.step}</span>
            <h3 class="mt-2 text-lg font-bold text-neutral-950">{step.title}</h3>
            <p class="mt-1 text-sm text-neutral-600 leading-relaxed">{step.description}</p>
          </li>
        ))}
      </ol>
    </Container>
  </section>

  <FaqSection faqs={service.faqs} title={`${service.shortTitle}: common questions`} class="bg-neutral-50" />

  <!-- Related Services -->
  <section class="py-20 sm:py-24">
    <Container>
      <RelatedServices relatedSlugs={service.relatedSlugs} />
    </Container>
  </section>

  <CTASection title={`Ready to talk about ${service.shortTitle.toLowerCase()}?`} />
</BaseLayout>
